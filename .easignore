# Monorepo safety: only upload the Expo app required for EAS builds.
*
!frontend/
!frontend/**

# Re-exclude generated and local-only files inside the app workspace.
frontend/node_modules/
frontend/.expo/
frontend/.metro-cache/
frontend/android/.gradle/
frontend/android/.kotlin/
frontend/android/build/
frontend/android/app/build/
frontend/android/app/.cxx/
frontend/**/android/build/
frontend/**/.cxx/
frontend/.idea/
frontend/.vscode/
frontend/*.log
frontend/*.hprof
frontend/.env
frontend/.env*.local
